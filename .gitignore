# This folder is also the working folder of the project: recordings, scores, trained brains,
# composed tracks, logs and local settings live beside the code. Everything is ignored unless
# it is listed here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/docs/
!/brain/
!/site/
!/engine/
!/tools/
!/pipeline/

/docs/*
!/docs/*.md

# the transcription pipeline as a skeleton, with a synthetic score in the real format
/pipeline/*
!/pipeline/*.py
!/pipeline/README.md

/tools/*
!/tools/track_summary.py
!/tools/track_means.py
!/tools/kick_patterns.py
!/tools/build_radio.py

# the trainer, the layouts and the readings
/brain/*
!/brain/anatomy.py
!/brain/check.py
!/brain/common.py
!/brain/composition.py
!/brain/gate.py
!/brain/groove.py
!/brain/hierarchy.py
!/brain/layouts.py
!/brain/listen.py
!/brain/probe_recall.py
!/brain/quality.py
!/brain/recall_trace.py
!/brain/timbre.py
!/brain/train.py
!/brain/test_composer.py
!/brain/test_hierarchy.py

# the player, Stats, the mixer with the Auto DJ, the repertoire editor
/site/*
!/site/serve.py
!/site/shelf.py
!/site/training_stats.py
!/site/brainview.py
!/site/curator.py
!/site/curate_auto.py
!/site/feedback_marks.py
!/site/suggest.py
!/site/e2e_test.py
!/site/test_playback.py
!/site/test_stats_live.py
!/site/test_autodj.mjs
!/site/autodj.js
!/site/brains.js
!/site/brainviz.js
!/site/curator.js
!/site/deckworklet.js
!/site/djfx.js
!/site/kit.js
!/site/main.js
!/site/mixer.js
!/site/rack.js
!/site/stats.js
!/site/wave.js
!/site/worklet.js
!/site/radio.js
!/site/index.html
!/site/mixer.html
!/site/curator.html
!/site/repertoire-list.html
!/site/play-reading.json

# the audio engine, its Node tools and the drum machine one-shots
/engine/*
!/engine/*.mjs
!/engine/demo_score.json
!/engine/sid_params.json
!/engine/samples/
/engine/samples/*
!/engine/samples/README.md
!/engine/samples/index.json
!/engine/samples/606/
!/engine/samples/808/
!/engine/samples/909/
